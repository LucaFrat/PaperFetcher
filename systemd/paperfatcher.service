[Unit]
Description=PaperFatcher daily run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/dev/PaperFatcher
ExecStart=/usr/bin/env bash %h/dev/PaperFatcher/run.sh
StandardOutput=append:%h/dev/PaperFatcher/logs/systemd.out.log
StandardError=append:%h/dev/PaperFatcher/logs/systemd.err.log
